<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
	  <RootNamespace>Fabrick</RootNamespace>
    <Title>FABRICK ENGINE</Title>
    <Authors>Batara Fobaku</Authors>
    <Company>Fabrick Dev</Company>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.20" />
    <PackageReference Include="SDL3-CS.Native" Version="3.4.2" />
    <PackageReference Include="SDL3-CS.Native.Image" Version="3.5.0" />
    <PackageReference Include="SDL3-CS.Native.Mixer" Version="3.2.0" />
    <PackageReference Include="SDL3-CS.Native.Shadercross" Version="3.0.0" />
    <PackageReference Include="SDL3-CS.Native.TTF" Version="3.3.0" />
  </ItemGroup>

</Project>
